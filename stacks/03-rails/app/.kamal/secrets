# Secrets for config/deploy.yml. Safe to commit: this file holds commands, not
# values. Kamal evaluates it in its own shell at deploy time and passes the
# results to the container as environment variables.
#
# The database password and the S3 key were generated by Terraform, so they are
# read from Terraform. Nothing here is typed, pasted or stored in git.

DB_PASSWORD=$(terraform -chdir=../terraform output -raw db_password)
AWS_ACCESS_KEY_ID=$(terraform -chdir=../terraform output -raw app_access_key_id)
AWS_SECRET_ACCESS_KEY=$(terraform -chdir=../terraform output -raw app_secret_access_key)

# Not infrastructure, so not Terraform: generated once by `make rails` and kept
# out of git, so sessions survive redeploys.
SECRET_KEY_BASE=$(cat ../host/state/secret_key_base)
