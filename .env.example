# Floci accepts any credentials; these are conventional placeholders.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# Do NOT set AWS_ENDPOINT_URL and assume it works — it needs aws-cli >= 2.13.
# Older CLIs ignore it and talk to real AWS. Use ./scripts/awslocal instead.

TF_VAR_db_password=demo_password_not_a_real_secret
